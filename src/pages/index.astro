---
import Base from '../layouts/Base.astro'
import { batches, ticketsForBatch, hoursFor, areasOf } from '../data'

const sections = batches.map((batch) => {
  const list = ticketsForBatch(batch.id)
  return {
    batch,
    total: list.length,
    hours: hoursFor(list),
    areas: areasOf(list).map((area) => ({
      area,
      items: list.filter((ticket) => ticket.area === area),
    })),
  }
})

const allTickets = sections.flatMap((s) => s.areas.flatMap((a) => a.items))
const totalHours = hoursFor(allTickets)
---

<Base
  title="CodeLingo — Project Tickets"
  description="Every CodeLingo build ticket as its own shareable HTML page: Week One and Batch Two plans with files, approach, definition of done and a check."
>
  <section class="hero">
    <div class="hero-inner">
      <p class="kicker">project tickets · html pages</p>
      <h1>CodeLingo build tickets</h1>
      <p class="dek">
        Every ticket is a standalone HTML page you can share as a plain link — what you're
        building, the files to touch, how to build it, the definition of done and the check.
      </p>
      <div class="stats">
        <div class="stat"><span class="n">{sections.length}</span><span class="l">batches</span></div>
        <div class="stat"><span class="n">{allTickets.length}</span><span class="l">tickets</span></div>
        <div class="stat"><span class="n">{totalHours}h</span><span class="l">estimated total</span></div>
        <div class="stat"><span class="n">{(sections[0]?.areas.length ?? 0)} / {(sections[1]?.areas.length ?? 0)}</span><span class="l">areas per batch</span></div>
      </div>
    </div>
  </section>

  <main class="wrap">
    {sections.map(({ batch, total, hours, areas }) => (
      <section class="batch" id={batch.id} data-batch={batch.id}>
        <div class="batch-head">
          <h2>{batch.title}</h2>
          <span class="count">{total} tickets · ~{hours}h</span>
          <div class="progress-wrap">
            <div class="progress-track"><span data-progress-bar={batch.id}></span></div>
            <span class="progress-label" data-progress-label={batch.id}>0 of {total} done</span>
          </div>
        </div>

        {batch.intro && <div class="intro-card" set:html={batch.intro} />}

        {areas.map(({ area, items }) => (
          <>
            <h3 class="group-title">{area} tickets</h3>
            <div class="ticket-grid cols-2">
              {items.map((ticket) => (
                <a
                  class="ticket-card"
                  href={`/tickets/${ticket.id.toLowerCase()}/`}
                  data-ticket-card={ticket.id}
                >
                  <span class="num">{ticket.number}</span>
                  <div style="flex:1">
                    <h3>{ticket.title}</h3>
                    <div class="tags">
                      <span class={`tag ${ticket.area.toLowerCase()}`}>{ticket.area}</span>
                      {ticket.estimate && <span class="tag">{ticket.estimate}</span>}
                      <span class="tag depends">Depends on: {ticket.dependsOn}</span>
                    </div>
                    {ticket.summary && <p class="summary">{ticket.summary}</p>}
                  </div>
                </a>
              ))}
            </div>
          </>
        ))}
      </section>
    ))}
  </main>

  <script>
    const KEY = 'codlingo-tickets-progress'
    const load = () => {
      try { return JSON.parse(localStorage.getItem(KEY) || '{}') } catch { return {} }
    }
    const state: Record<string, boolean> = load()

    document.querySelectorAll<HTMLElement>('[data-ticket-card]').forEach((card) => {
      const id = card.dataset.ticketCard ?? ''
      if (state[id]) card.classList.add('done')
    })

    const batchIds = new Set(
      [...document.querySelectorAll<HTMLElement>('[data-batch]')].map((el) => el.dataset.batch ?? ''),
    )
    batchIds.forEach((batchId) => {
      const cards = [...document.querySelectorAll(`[data-batch="${batchId}"] [data-ticket-card]`)]
      const done = cards.filter((c) => (c as HTMLElement).classList.contains('done')).length
      const bar = document.querySelector<HTMLElement>(`[data-progress-bar="${batchId}"]`)
      const label = document.querySelector<HTMLElement>(`[data-progress-label="${batchId}"]`)
      const pct = cards.length ? Math.round((done / cards.length) * 100) : 0
      if (bar) bar.style.width = `${pct}%`
      if (label) label.textContent = `${done} of ${cards.length} done`
    })
  </script>
</Base>