---
import Base from '../layouts/Base.astro'
import lessonsHtml from '../CodeLingo Lesson Tickets.html?raw'
import { tickets } from '../data/index.ts'

// The lesson page keeps its tickets in a JS array, so count them from the source
// instead of hardcoding numbers that go stale.
const lessonIds = [
  ...new Set([...lessonsHtml.matchAll(/id:\s*['"](LES-[A-Za-z0-9]+)['"]/g)].map((m) => m[1])),
]
const lessonsOpen = lessonIds.filter((id) => !id.startsWith('LES-L')).length
const lessonsLater = lessonIds.length - lessonsOpen

const mobileOpen = tickets.filter((ticket) => !ticket.blocked).length
const mobileBlocked = tickets.length - mobileOpen

const sets = [
  {
    no: '01',
    href: 'mobile/',
    eyebrow: 'Mobile app',
    title: 'Mobile app tickets',
    desc: 'Rebuild the CodeLingo web app on phones against the same backend: auth, onboarding, diagnostic, syllabus and profile, ticket by ticket.',
    meta: [`${tickets.length} tickets`, `${mobileOpen} to build`, `${mobileBlocked} blocked`],
  },
  {
    no: '02',
    href: 'lessons/',
    eyebrow: 'Web app lessons',
    title: 'Lesson feature tickets',
    desc: 'Add Duolingo-style lessons to the web app: five exercise types, server-side grading, XP and streaks, from data model to the lesson player.',
    meta: [`${lessonIds.length} tickets`, `${lessonsOpen} to build`, `${lessonsLater} later`],
  },
]
---

<Base
  title="CodeLingo build tickets"
  description="Two ticket sets for the CodeLingo build: the mobile app rebuild and the web lesson feature."
>
  <nav slot="nav">
    <a href="mobile/">Mobile</a>
    <a href="lessons/">Lessons</a>
  </nav>

  <main class="hub">
    <header class="mast">
      <p class="kicker">CodeLingo / build board</p>
      <h1>Two ticket sets. Pick the one you're building.</h1>
      <p class="dek">
        Each set is one working page: tickets in build order, the endpoints they call, and a
        done-checkbox you tick as you go.
      </p>
    </header>

    <ol class="sets">
      {
        sets.map((set) => (
          <li>
            <a class="set" href={set.href}>
              <span class="ord" aria-hidden="true">{set.no}</span>
              <span class="main">
                <span class="eyebrow">{set.eyebrow}</span>
                <span class="title">{set.title}</span>
                <span class="desc">{set.desc}</span>
                <span class="tags">
                  {set.meta.map((item) => (
                    <span class="tag">{item}</span>
                  ))}
                </span>
              </span>
              <span class="go" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="note">
      Ticking a ticket off is saved in this browser only, and the progress bar on that set follows.
    </p>
  </main>
</Base>

<style>
  .hub {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(40px, 7vw, 88px) 20px 72px;
    background-image: radial-gradient(
      90% 60% at 50% 0%,
      color-mix(in srgb, var(--accent-soft) 60%, transparent),
      transparent 75%
    );
  }

  .mast {
    max-width: 640px;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.05em;
    color: var(--teal);
    margin: 0 0 16px;
  }
  h1 {
    font-size: clamp(34px, 6vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .dek {
    font-size: 17px;
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0;
  }

  .sets {
    list-style: none;
    margin: clamp(34px, 5vw, 56px) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .sets li {
    border-bottom: 1px solid var(--line);
  }

  .set {
    position: relative;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    gap: clamp(14px, 3vw, 26px);
    align-items: start;
    padding: clamp(22px, 3vw, 30px) 12px;
    margin: 0 -12px;
    color: inherit;
    text-decoration: none;
    transition: background 0.18s ease;
  }
  .set::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 -1px;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.22s ease;
  }
  .set:hover,
  .set:focus-visible {
    background: color-mix(in srgb, var(--accent-soft) 42%, transparent);
  }
  .set:hover::before,
  .set:focus-visible::before {
    transform: scaleY(1);
  }

  .ord {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    padding-top: 6px;
    transition: color 0.18s ease;
  }
  .set:hover .ord,
  .set:focus-visible .ord {
    color: var(--accent);
  }

  .main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .title {
    font-family: var(--serif);
    font-size: clamp(23px, 3vw, 29px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .desc {
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .tags {
    margin-top: 4px;
  }

  .go {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper-raised);
    color: var(--teal);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .set:hover .go,
  .set:focus-visible .go {
    transform: translateX(3px);
    border-color: var(--teal);
  }

  .note {
    margin: 26px 0 0;
    font-size: 13px;
    color: var(--ink-faint);
    max-width: 60ch;
  }

  @media (max-width: 620px) {
    .set {
      grid-template-columns: minmax(0, 1fr) auto;
      padding-inline: 10px;
      margin-inline: -10px;
    }
    .ord {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .set,
    .set::before,
    .go,
    .ord {
      transition: none;
    }
  }
</style>
