---
import Base from '../../layouts/Base.astro'
import { batches, tickets, ticketsForBatch, type Ticket } from '../../data'

export async function getStaticPaths() {
  return batches.flatMap((batch) =>
    ticketsForBatch(batch.id).map((ticket) => ({
      params: { id: ticket.id.toLowerCase() },
      props: { ticket },
    })),
  )
}

const { ticket } = Astro.props as { ticket: Ticket }
const batch = batches.find((b) => b.id === ticket.batch)
// Pagination runs across every ticket, so the last Week One ticket links into Batch Two.
const index = tickets.findIndex((t) => t.id === ticket.id)
const prev = tickets[index - 1]
const next = tickets[index + 1]
const siblings = ticketsForBatch(ticket.batch)

// Resolve "Depends on: ..." into links to the sibling ticket pages.
const depHtml = ticket.dependsOn
  ? ticket.dependsOn.replace(/(SYL-\d+)/gi, (id) => {
      const target = siblings.find((t) => t.id === id.toUpperCase())
      return target
        ? `<a href="/tickets/${target.id.toLowerCase()}/">${target.id}</a>`
        : id
    })
  : ''

const pageTitle = `${ticket.id} — ${ticket.title}`
const description = ticket.summary || `${batch?.label}: ${ticket.title}`
---

<Base title={`${pageTitle} · CodeLingo Tickets`} description={description}>
  <main class="wrap">
    <p class="crumb">
      <a href="/">Tickets</a> / <a href={`/#${ticket.batch}`}>{batch?.title}</a> / {ticket.id}
    </p>

    <div class="ticket-head">
      <span class="big-num">{ticket.number}</span>
      <div class="headline">
        <h1>{ticket.title}</h1>
        <div class="tags">
          <span class={`tag ${ticket.area.toLowerCase()}`}>{ticket.area}</span>
          {ticket.estimate && <span class="tag">{ticket.estimate}</span>}
          <span class="tag">Batch: {batch?.label}</span>
          <span class="tag depends" set:html={`Depends on: ${depHtml || '—'}`}></span>
        </div>
      </div>
      <label class="check" title="Tick when finished — saved on this device">
        <input type="checkbox" data-ticket={ticket.id} aria-label={`Mark ${ticket.id} as done`} />
        <span class="box">
          <svg viewBox="0 0 16 16" fill="none">
            <path d="M3 8.5 6.5 12 13 4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </label>
    </div>

    {ticket.summary && <p class="summary-lede">{ticket.summary}</p>}

    {ticket.why && (
      <section class="panel">
        <h2>Why this ticket exists</h2>
        <p>{ticket.why}</p>
      </section>
    )}

    {ticket.see && (
      <section class="panel see">
        <h2>What you will see working</h2>
        <p set:html={ticket.see} />
      </section>
    )}

    {ticket.files && ticket.files.length > 0 && (
      <section class="panel">
        <h2>Files you'll touch</h2>
        <ul class="filelist">
          {ticket.files.map((file) => <li set:html={file} />)}
        </ul>
      </section>
    )}

    {ticket.how && (
      <section class="panel">
        <h2>How to build it</h2>
        <p set:html={ticket.how} />
      </section>
    )}

    {ticket.dod && ticket.dod.length > 0 && (
      <section class="panel">
        <h2>Definition of done</h2>
        <ul class="dod">
          {ticket.dod.map((item) => <li set:html={item} />)}
        </ul>
      </section>
    )}

    {ticket.verify && (
      <section class="panel">
        <h2>How to check your work</h2>
        <pre class="verify" set:html={ticket.verify} />
      </section>
    )}

    <nav class="pager">
      {prev ? (
        <a href={`/tickets/${prev.id.toLowerCase()}/`}>
          <span class="dir">← {prev.id}</span>
          <span class="title">{prev.title}</span>
        </a>
      ) : <span class="spacer" />}
      {next ? (
        <a href={`/tickets/${next.id.toLowerCase()}/`} style="text-align:right">
          <span class="dir">{next.id} →</span>
          <span class="title">{next.title}</span>
        </a>
      ) : <span class="spacer" />}
    </nav>
  </main>

  <script>
    const KEY = 'codlingo-tickets-progress'
    const box = document.querySelector<HTMLInputElement>('input[data-ticket]')
    if (box) {
      const id = box.dataset.ticket ?? ''
      let state: Record<string, boolean> = {}
      try { state = JSON.parse(localStorage.getItem(KEY) || '{}') } catch { state = {} }
      box.checked = Boolean(state[id])
      box.addEventListener('change', () => {
        state[id] = box.checked
        localStorage.setItem(KEY, JSON.stringify(state))
      })
    }
  </script>
</Base>